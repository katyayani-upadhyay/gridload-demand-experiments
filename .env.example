GRIDLOAD_RAW_DIR=data/raw
GRIDLOAD_REPORTS_DIR=reports
OPSD_TIME_SERIES_URL=https://data.open-power-system-data.org/time_series/2020-10-06/time_series_60min_singleindex.csv
